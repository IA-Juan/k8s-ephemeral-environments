<!DOCTYPE html>

<html>

<head>

<title>
EDC Kubernetes Environment
</title>

</head>


<body>

<h1>
Kubernetes Ephemeral Environment
</h1>


<hr>


<h2>
Environment:
<%= environment %>
</h2>


<h2>
Namespace:
<%= namespace %>
</h2>


<p>
Application status:
<b>
RUNNING
</b>
</p>


<p>
Database status:
Check /db endpoint
</p>
<hr>

<h2>
Database records
</h2>


<ul>

<% records.forEach(record => { %>

<li>

<b>
<%= record.environment %>
</b>

-

<%= record.status %>

<br>

Created:
<%= record.created_at %>

</li>

<% }) %>

</ul>

</body>

</html>